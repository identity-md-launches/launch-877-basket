  "documentedGuardedCallChanges": {
    "Flows.tsx": {
      "why": "\"You received ... BASK\": one read of the receipt of the visitor's own confirmed deposit (the hash send() reported), to take the minted shares from its Deposit event; it runs after the deposit is confirmed and feeds only that line. The running total parses each typed amount with the page's own amount() to show an estimate in dollars; it runs while the form is drawn, outside every handler, and its result goes into no preview, approval or deposit (those still parse inputs[a.token] themselves, as at HEAD).",
      "removed": [],
      "added": [
        [
          "client .getTransactionReceipt({ hash: done.hash })",
          "DepositPage"
        ],
        [
          "amount(text, false, a.tokenDecimals)",
          "DepositPage"
        ]
      ]
    },
    "wallet.tsx": {
      "why": "Disconnect forgets the wallet only on this page. It adds no provider request, avoiding a late permission revocation undoing a later Connect in this page or another tab.",
      "removed": [],
      "added": []
    }
  },
